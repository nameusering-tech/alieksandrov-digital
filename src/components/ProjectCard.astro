---
import { Picture } from 'astro:assets';
import { images } from '../data/images';
import type { ProjectBase } from '../data/site';
import { t, href, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  project: ProjectBase;
  heading?: 'h2' | 'h3';
}
const { lang, project, heading: H = 'h3' } = Astro.props;
const d = t(lang).projects;
const text = d.items[project.slug];
---

<a class="project glass" href={href(lang, `/projekte/${project.slug}/`)} data-tilt data-reveal>
  <div class="project-media">
    <Picture
      src={images[project.images[0]]}
      alt={text.alts[0]}
      formats={['avif']}
      fallbackFormat="webp"
      widths={[480, 800, 1200]}
      sizes="(min-width: 48rem) 33vw, 92vw"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="project-body">
    <span class="project-kind">{text.kind}</span>
    <H>{text.title}</H>
    <p>{text.description}</p>
    <span class="project-more">{d.view}</span>
  </div>
</a>
