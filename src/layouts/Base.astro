---
import '../styles/index.css';
import barlowUrl from '../assets/fonts/barlow-condensed-600-latin.woff2?url';
import ptSansUrl from '../assets/fonts/pt-sans-400-latin.woff2?url';
import oswaldCyrUrl from '../assets/fonts/oswald-600-cyrillic.woff2?url';
import ptSansCyrUrl from '../assets/fonts/pt-sans-400-cyrillic.woff2?url';
import logoRaw from '../assets/logo.svg?raw';
import { site } from '../data/site';
import { t, href, pathIn, base, type Lang } from '../i18n';

interface Crumb {
  name: string;
  href: string;
}
interface Props {
  lang: Lang;
  title: string;
  description: string;
  og?: string;
  crumbs?: Crumb[];
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  ogType?: string;
}

const { lang, title, description, og = 'start', crumbs = [], schema = [], ogType = 'website' } = Astro.props;
// Testkopie auf GitHub Pages: nicht indexieren (PUBLIC_NOINDEX=1 im Workflow)
const noindex = Astro.props.noindex || import.meta.env.PUBLIC_NOINDEX === '1';
const d = t(lang);
const path = Astro.url.pathname;
const origin = Astro.site?.origin ?? site.url;
const abs = (p: string) => new URL(p, origin).href;
const canonical = abs(path);
const ogImage = abs(`${base}/og/${lang === 'uk' ? 'uk-' : ''}${og}.png`);
const logo = logoRaw.replace('<svg ', '<svg aria-hidden="true" focusable="false" ');
const is404 = path.startsWith(`${base}/404`);
const dePath = is404 ? href('de', '/') : pathIn('de', path);
const ukPath = is404 ? href('uk', '/') : pathIn('uk', path);
const preloads = lang === 'uk' ? [oswaldCyrUrl, ptSansCyrUrl] : [barlowUrl, ptSansUrl];

const personId = `${site.url}/#person`;
const websiteId = `${site.url}/#website`;
const graph: Record<string, unknown>[] = [
  {
    '@type': 'WebSite',
    '@id': websiteId,
    url: `${site.url}/`,
    name: site.brand,
    inLanguage: ['de-DE', 'uk-UA'],
    publisher: { '@id': personId },
  },
  {
    '@type': 'Person',
    '@id': personId,
    name: 'Oleksandr Alieksandrov',
    alternateName: 'Олександр Алєксандров',
    givenName: 'Oleksandr',
    familyName: 'Alieksandrov',
    jobTitle: d.jobTitle,
    url: abs(href(lang, '/ueber-mich/')),
    email: `mailto:${site.email}`,
    telephone: site.phoneHref,
    knowsLanguage: ['de', 'uk'],
    knowsAbout: ['Webdesign', 'Webentwicklung', 'WordPress', 'Figma', 'n8n', 'Make.com', 'KI-Automatisierung', 'Linux'],
    image: abs(`${base}/og/start.png`),
    address: { '@type': 'PostalAddress', addressLocality: site.address.city, addressRegion: 'NW', addressCountry: 'DE' },
    homeLocation: { '@type': 'City', name: 'Hennef (Sieg)' },
  },
  {
    '@type': 'WebPage',
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: title,
    description,
    inLanguage: lang === 'uk' ? 'uk-UA' : 'de-DE',
    isPartOf: { '@id': websiteId },
    about: { '@id': personId },
  },
];
if (crumbs.length) {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: [{ name: d.ui.start, href: href(lang, '/') }, ...crumbs].map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.name,
      item: abs(c.href),
    })),
  });
}
graph.push(...schema);
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
const speculation = JSON.stringify({ prerender: [{ where: { href_matches: `${base || ''}/*` }, eagerness: 'moderate' }] });
const isCurrent = (p: string) => path.startsWith(href(lang, p));
const nav = [
  { path: '/projekte/', label: d.ui.projects },
  { path: '/ueber-mich/', label: d.ui.about },
];
---

<!doctype html>
<html lang={d.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && <link rel="alternate" hreflang="de" href={abs(dePath)} />}
    {!noindex && <link rel="alternate" hreflang="uk" href={abs(ukPath)} />}
    {!noindex && <link rel="alternate" hreflang="x-default" href={abs(dePath)} />}
    <meta name="author" content={d.name} />
    <meta name="theme-color" content="#111111" />
    <meta name="geo.region" content="DE-NW" />
    <meta name="geo.placename" content="Hennef (Sieg)" />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={d.ogLocale} />
    <meta property="og:locale:alternate" content={lang === 'uk' ? 'de_DE' : 'uk_UA'} />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href={`${base}/favicon.ico`} sizes="32x32" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    {preloads.map((url) => <link rel="preload" href={url} as="font" type="font/woff2" crossorigin />)}

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <script type="application/ld+json" is:inline set:html={jsonLd} />
    <script type="speculationrules" is:inline set:html={speculation} />
  </head>
  <body>
    <a class="skip" href="#inhalt">{d.ui.skip}</a>

    <header class="header" data-header>
      <div class="header-bar">
        <a class="logo" href={href(lang, '/')} aria-label={d.ui.logoLabel} set:html={logo} />
        <nav class="nav" id="hauptnavigation" aria-label={d.ui.mainNav}>
          <ul class="nav-list">
            {
              nav.map((item, i) => (
                <li style={`--n:${i}`}>
                  <a href={href(lang, item.path)} aria-current={isCurrent(item.path) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li style={`--n:${nav.length}`}>
              <a class="btn btn-primary" href={href(lang, '/kontakt/')} data-magnetic aria-current={isCurrent('/kontakt/') ? 'page' : undefined}>
                {d.ui.contact}
              </a>
            </li>
          </ul>
        </nav>
        <div class="header-tools">
          <nav class="lang" aria-label={d.ui.langNav}>
            <a href={dePath} lang="de" hreflang="de" aria-label="Deutsch" aria-current={lang === 'de' ? 'true' : undefined}>DE</a>
            <a href={ukPath} lang="uk" hreflang="uk" aria-label="Українська" aria-current={lang === 'uk' ? 'true' : undefined}>UA</a>
          </nav>
          <button
            class="menu-btn"
            type="button"
            aria-expanded="false"
            aria-controls="hauptnavigation"
            data-menu-btn
            data-open={d.ui.menu}
            data-close={d.ui.close}
          >
            <span data-menu-label>{d.ui.menu}</span>
          </button>
        </div>
      </div>
    </header>

    <main id="inhalt">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <a class="logo" href={href(lang, '/')} aria-label={d.ui.logoLabel} set:html={logo} />
            <p style="margin-top:.75rem;max-width:22em">{d.ui.footerText}</p>
          </div>
          <nav aria-label={d.ui.pages}>
            <h2>{d.ui.pages}</h2>
            <ul>
              <li><a href={href(lang, '/projekte/')}>{d.ui.projects}</a></li>
              <li><a href={href(lang, '/ueber-mich/')}>{d.ui.about}</a></li>
              <li><a href={href(lang, '/kontakt/')}>{d.ui.contact}</a></li>
            </ul>
          </nav>
          <nav aria-label={d.ui.legal}>
            <h2>{d.ui.legal}</h2>
            <ul>
              <li><a href={href(lang, '/impressum/')}>{d.ui.impressum}</a></li>
              <li><a href={href(lang, '/datenschutz/')}>{d.ui.privacy}</a></li>
              <li><a href={href(lang, '/barrierefreiheit/')}>{d.ui.a11y}</a></li>
            </ul>
          </nav>
          <div>
            <h2>{d.ui.contact}</h2>
            <ul>
              <li><a href={`tel:${site.phoneHref}`}>{site.phoneDisplay}</a></li>
              <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
              <li><a href={site.whatsapp} rel="noopener">WhatsApp</a></li>
            </ul>
          </div>
        </div>
        <p class="footer-bottom">© {new Date().getFullYear()} {d.name} · {d.city}</p>
      </div>
    </footer>

    <div class="cursor" aria-hidden="true" data-cursor></div>
    <script>
      import '../scripts/app.ts';
    </script>
  </body>
</html>
