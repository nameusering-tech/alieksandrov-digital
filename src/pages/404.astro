---
import Base from '../layouts/Base.astro';
import { t, href } from '../i18n';
const de = t('de');
const uk = t('uk');
---

<Base lang="de" title={de.meta.notFound.title} description={de.meta.notFound.description} noindex>
  <section class="page-head" style="min-height:80svh">
    <div class="wrap">
      <p style="font:400 clamp(6rem,24vw,14rem)/.8 var(--font-mono);color:var(--orange)" aria-hidden="true">404</p>
      <h1 style="margin-top:1.5rem">{de.notFound.title}</h1>
      <p class="lead">{de.notFound.text}</p>
      <p style="margin-top:2rem;display:flex;flex-wrap:wrap;gap:.75rem">
        <a class="btn btn-primary" href={href('de', '/')}>{de.notFound.home}</a>
        <a class="btn btn-ghost" href={href('de', '/projekte/')}>{de.ui.viewProjects}</a>
      </p>
      <p class="lead" lang="uk" style="margin-top:3rem">
        {uk.notFound.title}. {uk.notFound.text}{' '}<a class="text-link" href={href('uk', '/')}>{uk.notFound.home}</a>
      </p>
    </div>
  </section>
</Base>
