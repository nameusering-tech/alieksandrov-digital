---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Contact from '../components/Contact.astro';
import aboutImg from '../assets/about.jpg';
import { site, stats, stack, projects } from '../data/site';
import { t, href, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const schema = [
  {
    '@type': 'FAQPage',
    mainEntity: d.faq.items.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<Base lang={lang} title={d.meta.home.title} description={d.meta.home.description} schema={schema}>
  <section class="hero">
    <div class="hero-panel">
      <canvas class="hero-canvas" data-hero-canvas aria-hidden="true"></canvas>
      <div class="hero-grid">
        <div>
          <h1 aria-label={d.hero.lines.join(' ')}>
            {
              d.hero.lines.map((line, i) => (
                <span class="line" aria-hidden="true">
                  <span style={`--i:${i}`}>{line}</span>
                </span>
              ))
            }
          </h1>
          <p class="hero-lead hero-in" style="--i:1">{d.hero.lead}</p>
          <div class="hero-cta hero-in" style="--i:2">
            <a class="btn btn-primary" href={href(lang, '/kontakt/')}>{d.ui.contactCta}</a>
            <a class="btn btn-ghost" href={href(lang, '/projekte/')}>{d.ui.viewProjects}</a>
          </div>
        </div>
        <div class="hero-side hero-in" style="--i:4">
          <div class="hero-card glass hero-now">
            <span class="num" aria-hidden="true">9+</span>
            <p><span class="sr-only">9+ </span>{d.hero.cardStat}</p>
          </div>
          <div class="hero-card glass">
            <h2>{d.hero.directTitle}</h2>
            <p>{d.hero.directText}</p>
            <div class="row">
              <a class="icon-btn is-hot" href={site.whatsapp} rel="noopener" aria-label={d.hero.waLabel}><Icon name="whatsapp" /></a>
              <a class="icon-btn" href={`mailto:${site.email}`} aria-label={d.hero.mailLabel}><Icon name="mail" /></a>
              <a class="icon-btn" href={`tel:${site.phoneHref}`} aria-label={`${d.hero.phoneLabel}: ${site.phoneDisplay}`}><Icon name="phone" /></a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="block" aria-labelledby="zahlen">
    <div class="wrap">
      <div class="stats-card glass" data-reveal>
        <div class="stats-top">
          <h2 id="zahlen" class="sr-only">{d.stats.title}</h2>
          <p class="muted">{d.stats.muted}</p>
          <p class="statement">{d.stats.statementA} <span>{d.stats.statementB}</span></p>
        </div>
        <ul class="stats-list">
          {
            stats.map((s, i) => (
              <li class="stat">
                <span class="num" data-count={s.value} data-suffix={s.suffix}>{s.value}{s.suffix}</span>
                <strong class="stat-label">{d.stats.items[i].label}</strong>
                <span class="stat-text">{d.stats.items[i].text}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="block" aria-labelledby="seit">
    <div class="wrap since">
      <div class="since-text" data-reveal>
        <h2 id="seit" class="since-title">{d.since.a} <b>2021</b><br />{d.since.b}</h2>
        <p class="since-sub">{d.since.sub}</p>
      </div>
      <ul class="stack" aria-label={d.since.stackLabel} data-reveal>
        {stack.map((name) => <li lang="en">{name}</li>)}
      </ul>
    </div>
  </section>

  <section class="block" aria-labelledby="schwerpunkte">
    <div class="wrap">
      <div class="block-head" data-reveal>
        <h2 id="schwerpunkte">{d.focus.title}</h2>
        <p class="lead">{d.focus.lead}</p>
      </div>
      <div class="cards cards-3">
        {
          d.focus.items.map((f) => (
            <article class="card glass" data-reveal>
              <h3>{f.title}</h3>
              <p>{f.short}</p>
              <ul class="ticks">
                {f.points.map((p) => <li>{p}</li>)}
              </ul>
              <a class="text-link" href={href(lang, `/projekte/${f.link.slug}/`)}>{f.link.label}</a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="block" aria-labelledby="projekte">
    <div class="wrap">
      <div class="block-head" data-reveal>
        <h2 id="projekte">{d.projects.title}</h2>
        <p class="lead">{d.projects.lead}</p>
      </div>
      <div class="cards cards-3">
        {projects.map((p) => <ProjectCard lang={lang} project={p} />)}
      </div>
    </div>
  </section>

  <section class="block" aria-labelledby="ueber">
    <div class="wrap split">
      <div class="split-media" data-reveal>
        <Picture
          src={aboutImg}
          alt={d.about.imgAlt}
          formats={['avif']}
          fallbackFormat="webp"
          widths={[480, 800, 1200]}
          sizes="(min-width: 56rem) 40vw, 92vw"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div data-reveal>
        <h2 id="ueber">{d.about.title}</h2>
        <div class="prose" style="margin-top:1.5rem">
          <p><strong>{d.about.strong}</strong></p>
          <p>{d.about.teaser}</p>
          <p><a class="text-link" href={href(lang, '/ueber-mich/')}>{d.about.teaserLink}</a></p>
        </div>
      </div>
    </div>
  </section>


  <section class="block" aria-labelledby="faq">
    <div class="wrap">
      <div class="block-head" data-reveal>
        <h2 id="faq">{d.faq.title}</h2>
      </div>
      <div class="faq" data-reveal>
        {
          d.faq.items.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="block" id="kontakt" aria-label={d.contact.title}>
    <div class="wrap">
      <Contact lang={lang} />
    </div>
  </section>
</Base>
